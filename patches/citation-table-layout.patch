+function Rows({ title, value, citedPages = false }: { title: string; value: { columns: string[]; rows: string[][] }; citedPages?: boolean }) {
+  const { locale } = useLiekanI18n();
+  const compact = citedPages && value.columns.length === 2 && value.columns[0].toLowerCase() === 'page' && value.columns[1].toLowerCase() === 'citations';
+  const labels = compact ? (locale === 'en-US' ? ['Page', 'Citations'] : ['页面', '引用次数']) : value.columns;
+  return <details className="min-w-0 text-[12px]"><summary className="cursor-pointer">{title} ({value.rows.length})</summary>
+    <div className="min-w-0 overflow-x-auto max-h-80 overflow-y-auto"><table data-layout={compact ? 'cited-pages' : undefined} className={`w-full text-left mt-2${compact ? ' table-fixed' : ''}`}><caption className="sr-only">{title}</caption>
+      {compact && <colgroup><col /><col className="w-24" /></colgroup>}
+      <thead><tr>{labels.map((c, i) => <th scope="col" key={i} className={`p-2 border-b border-line${compact && i === 1 ? ' text-right' : ''}`}>{c}</th>)}</tr></thead>
+      <tbody>{value.rows.map((row, i) => <tr key={i}>{row.map((cell, j) => <td key={j} className={`p-2 border-b border-line align-top ${compact ? (j === 0 ? 'whitespace-normal [overflow-wrap:anywhere]' : 'text-right tabular-nums whitespace-nowrap') : 'break-words'}`}>{cell}</td>)}</tr>)}</tbody>
+    </table></div>
+    {compact && <details className="mt-2"><summary className="cursor-pointer">{locale === 'en-US' ? 'Original source fields' : '原始来源字段'}</summary><p>{value.columns.join(' · ')}</p></details>}
+  </details>;
 }
