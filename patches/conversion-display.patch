+describe('configured conversion goal cards', () => {
+  const conversionCard = (report: Awaited<ReturnType<typeof buildReport>>, label: string) =>
+    report.cards.find(card => card.label === label);
+  it('does not declare a winner when all configured goals have zero observations', async () => {
+    const human = await mocks.human();
+    mocks.human.mockResolvedValue({ ...human, goals: [
+      { id: 'contact', name: '联系入口打开（微转化）', path: 'contact_open', count: 0, convertedSessions: 0 },
+      { id: 'template', name: '模板下载点击（微转化）', path: 'template_download_click', count: 0, convertedSessions: 0 },
+    ] });
+    const report = await buildReport(website, false, { ...params, resource: 'conversions' });
+    expect(conversionCard(report, '转化页 TOP1')).toMatchObject({ value: null, state: 'empty' });
+    expect(conversionCard(report, '白皮书下载')).toMatchObject({ value: 0, state: 'available' });
+  });
+  it('uses the goal name and exact configured template event without inflating or combining counts', async () => {
+    const human = await mocks.human();
+    mocks.human.mockResolvedValue({ ...human, goals: [
+      { id: 'contact', name: '联系入口打开（微转化）', path: 'contact_open', count: 5, convertedSessions: 2 },
+      { id: 'legacy', name: 'download whitepaper', path: 'old_download', count: 4, convertedSessions: 2 },
+      { id: 'template', name: '资料领取', path: 'template_download_click', count: 3, convertedSessions: 1 },
+    ] });
+    const report = await buildReport(website, false, { ...params, resource: 'conversions' });
+    expect(conversionCard(report, '转化页 TOP1')).toMatchObject({ value: '联系入口打开（微转化）', state: 'available' });
+    expect(conversionCard(report, '白皮书下载')).toMatchObject({ value: 3, state: 'available' });
+    expect(conversionCard(report, '白皮书下载')?.detail).toContain('资料领取');
+    expect(conversionCard(report, '全站转化率')).toMatchObject({ value: null, state: 'empty' });
+  });
+  it('distinguishes an unconfigured download goal from a measured zero', async () => {
+    const human = await mocks.human();
+    mocks.human.mockResolvedValue({ ...human, goals: [
+      { id: 'contact', name: '联系入口打开（微转化）', path: 'contact_open', count: 0, convertedSessions: 0 },
+    ] });
+    const report = await buildReport(website, false, { ...params, resource: 'conversions' });
+    expect(conversionCard(report, '白皮书下载')).toMatchObject({ value: null, state: 'not_connected' });
+  });
+  it('translates both display labels and goal-specific evidence without a Chinese fallback', () => {
+    expect(translateSystemText('转化目标 TOP1', 'en-US')).toBe('Top conversion goal');
+    expect(translateSystemText('下载目标次数', 'en-US')).toBe('Download goal events');
+    expect(translateSystemText('下载目标：Template request；记录目标事件，不代表下载完成', 'en-US'))
+      .toBe('Download goal: Template request. Counts goal events, not completed downloads.');
+  });
+});
