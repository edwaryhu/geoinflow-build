+export const gscApiEvidenceSchema = z.object({
+  protocol: z.literal('himax-gsc-api-display-v1'), property: z.literal('https://www.himaxtec.com/'),
+  collectedAt: z.string().datetime({offset:true}), sourceSha256: z.string().regex(/^[a-f0-9]{64}$/),
+  permissionLevel: z.literal('siteRestrictedUser'), credentialMode: z.literal('service_account'),
+  scheduledExecutionInstalled: z.boolean(),
+  lastAttempt: z.object({at:z.string().datetime({offset:true}),status:z.enum(['read_verified','failed'])}).strict().optional(),
+  window: z.object({start_date_inclusive:z.string().date(),end_date_inclusive:z.string().date(),source_timezone:z.literal('America/Los_Angeles'),data_state:z.literal('final')}).strict(),
+  scope: z.object({search_type:z.literal('web'),page_filter:z.literal('^https://(www\\.)?himaxtec\\.com/'),aggregation:z.literal('auto_with_page_filter'),ai_specific:z.literal(false)}).strict(),
