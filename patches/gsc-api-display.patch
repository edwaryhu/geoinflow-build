+import {describe,it,expect} from 'vitest';
+import {gscApiEvidenceSchema} from './gsc-api-evidence';
+import {officialSearchAiSchema} from './official-search-ai';
+import {officialFixture} from './official-search-ai.fixture';
+import {gscFixture} from './gsc-api-evidence.fixture';
+describe('GSC verified API evidence boundary',()=>{
+ it('accepts successful authenticated read with no rows without inventing processing/zero',()=>{const e=gscApiEvidenceSchema.parse(gscFixture());expect(e.availability).toBe('no_rows_returned');expect(e.processingStatus).toBe('unknown_not_reported_by_api');expect(e.reports.total.rows).toEqual([])});
+ it.each([{permissionLevel:'siteOwner'},{property:'https://unrelated.invalid/'},{processingStatus:'processing'},{sourceSha256:'bad'}])('rejects unsupported metadata %j',bad=>expect(gscApiEvidenceSchema.safeParse({...gscFixture(),...bad}).success).toBe(false));
+ it('rejects timezone substitution',()=>{const e=gscFixture();(e.window as any).source_timezone='Asia/Shanghai';expect(gscApiEvidenceSchema.safeParse(e).success).toBe(false)});
+ it('rejects status/row contradiction',()=>{const e=gscFixture();e.availability='observed_rows';expect(gscApiEvidenceSchema.safeParse(e).success).toBe(false)});
+ it('preserves partial observations and actual zero while total stays missing',()=>{const e=gscFixture();e.availability='observed_rows';e.reports.days={...e.reports.days,status:'observed',row_count:1,rows:[{date:'2020-01-02',clicks:0,impressions:2,ctr:0,position:3}]};const got=gscApiEvidenceSchema.parse(e);expect(got.reports.days.rows[0].clicks).toBe(0);expect(got.reports.total.rows).toEqual([])});
+ it('rejects duplicate or out-of-window dates',()=>{const e=gscFixture();e.availability='observed_rows';e.reports.days={...e.reports.days,status:'observed',row_count:1,rows:[{date:'2021-01-02',clicks:0,impressions:2,ctr:0,position:3}]};expect(gscApiEvidenceSchema.safeParse(e).success).toBe(false)});
+ it('rejects false API-connected snapshot without evidence',()=>{const s=officialFixture();s.gsc.automaticSync='api_read_verified';expect(officialSearchAiSchema.safeParse(s).success).toBe(false)});
+ it('accepts existing manual snapshot and separately verified API no_rows snapshot',()=>{const s=officialFixture();expect(officialSearchAiSchema.safeParse(s).success).toBe(true);s.gsc.apiEvidence=gscFixture();s.refreshMode='mixed_official_sources';s.gsc.automaticSync='api_read_verified';s.gsc.performance='no_rows_returned';expect(officialSearchAiSchema.safeParse(s).success).toBe(true)});
+ it('rejects invalid page URLs without throwing from safeParse',()=>{const e=gscFixture();e.availability='observed_rows';e.reports.pages={...e.reports.pages,status:'observed',row_count:1,rows:[{page:'not a URL',clicks:1,impressions:1,ctr:1,position:1}]};expect(gscApiEvidenceSchema.safeParse(e).success).toBe(false)});
+ it('rejects duplicate aggregate keys',()=>{const e=gscFixture();e.availability='observed_rows';const row={date:'2020-01-02',clicks:1,impressions:1,ctr:1,position:1};e.reports.days={...e.reports.days,status:'observed',row_count:2,rows:[row,row]};expect(gscApiEvidenceSchema.safeParse(e).success).toBe(false)});
+ it('rejects another property page even if headline property is Himax',()=>{const e=gscFixture();e.availability='observed_rows';e.reports.pages={...e.reports.pages,status:'observed',row_count:1,rows:[{page:'https://unrelated.invalid/',clicks:1,impressions:1,ctr:1,position:1}]};expect(gscApiEvidenceSchema.safeParse(e).success).toBe(false)});
+
+});
