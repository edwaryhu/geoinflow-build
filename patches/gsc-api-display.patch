+'use client';
+import { useLiekanI18n } from '@/lib/liekan/i18n/client';
+import type { GscApiEvidence as Evidence } from '@/lib/liekan/contracts/gsc-api-evidence';
+
+export function GscApiEvidence({ evidence: e }: { evidence: Evidence }) {
+  const { locale } = useLiekanI18n();
+  const t = (zh: string, en: string) => locale === 'en-US' ? en : zh;
+  const total = e.reports.total.rows[0];
+  const value = (v: number | null | undefined) => v ?? '—';
+  const stale = Date.now() - Date.parse(e.collectedAt) > 48 * 60 * 60 * 1000;
+  const failed = e.lastAttempt?.status === 'failed';
+  const views = [
+    ['total', t('搜索总览', 'Search overview')],
+    ['days', t('按日期', 'By date')],
+    ['pages', t('按页面', 'By page')],
+    ['countries_devices', t('按地区与设备组合', 'By country and device')],
+  ] as const;
+  const labels: Record<string, string> = {
+    date: t('日期', 'Date'), page: t('页面', 'Page'), page_language_group: t('页面语言', 'Page language'),
+    country: t('地区', 'Country'), device: t('设备', 'Device'), clicks: t('点击', 'Clicks'),
+    impressions: t('展示', 'Impressions'), ctr: t('点击率（比例）', 'CTR (ratio)'), position: t('平均排名', 'Average position'),
+  };
+  return <div className="space-y-2" aria-label={t('Google 官方搜索数据', 'Official Google search data')}>
+    <p>{t('最近一次成功取数', 'Latest successful collection')}：{e.collectedAt}</p>
+    {failed && <p role="status">{t('最近一次采集失败，以下保留上次成功数据；不是最新结果，也不按 0 处理。', 'The latest collection failed. Values below retain the previous successful observation, not a current result or zero.')} {t('失败时间', 'Failed at')}：{e.lastAttempt.at}</p>}
+    {stale && <p role="status">{t('数据已超过 48 小时未成功更新，请检查采集任务；不要当作当前表现。', 'No successful update for over 48 hours. Check collection; these values are not current performance.')}</p>}
+    <p>{e.scheduledExecutionInstalled
+      ? t('已配置定时采集；配置状态不代表任务正在正常运行。', 'Scheduled collection is configured; configuration does not establish current health.')
+      : t('定时采集尚未配置。', 'Scheduled collection is not configured.')}
+      {t('刷新面板只会读取已保存的数据，不会立即向 Google 查询。', 'Refreshing the panel reads saved data and does not query Google live.')}</p>
+    <p>{t('统计日期（含首尾日期）', 'Reporting dates (inclusive)')}：{e.window.start_date_inclusive} – {e.window.end_date_inclusive}</p>
+    <p>{t('点击 / 展示 / 点击率 / 平均排名', 'Clicks / impressions / CTR / average position')}：{value(total?.clicks)} / {value(total?.impressions)} / {total?.ctr === null || total?.ctr === undefined ? '—' : `${total.ctr * 100}%`} / {value(total?.position)}</p>
+    {e.availability === 'no_rows_returned' && <p>{t('Google 已成功响应，但该日期范围没有返回统计行。指标未知；不能据此判断为 0、数据处理中或没有搜索可见度。', 'Google responded successfully but returned no rows for this date range. Metrics remain unknown; this does not establish zero visibility or processing status.')}</p>}
+    {e.availability === 'observed_rows' && !total && <p>{t('有明细行，但总览未返回；不把明细相加冒充总量。', 'Detail rows were returned but no overview row; details are not summed into a total.')}</p>}
+    {views.map(([key, label]) => {
+      const r = e.reports[key];
+      const dimensions = key === 'days' ? ['date'] : key === 'pages' ? ['page', 'page_language_group'] : key === 'countries_devices' ? ['country', 'device'] : [];
+      const cols = [...dimensions, 'clicks', 'impressions', 'ctr', 'position'];
+      return <details key={key}>
+        <summary className="cursor-pointer">{label} ({r.row_count})</summary>
+        {!r.rows.length ? <p>{t('未返回统计行，不能按 0 解读。', 'No rows returned; not zero.')}</p> : <div className="overflow-auto max-h-80"><table className="w-full text-left">
+          <caption className="sr-only">{label}</caption>
+          <thead><tr>{cols.map(c => <th key={c} className="p-2">{labels[c]}</th>)}</tr></thead>
+          <tbody>{r.rows.map((row, i) => <tr key={i}>{cols.map(c => <td className="p-2" key={c}>{String((row as Record<string, unknown>)[c] ?? '—')}</td>)}</tr>)}</tbody>
+        </table></div>}
+      </details>;
+    })}
+    <p>{t('各聚合独立，不强求各维度对齐。这是 Google 搜索表现；AI 引用、索引检查、浏览器访问是独立数据。', 'Aggregations remain separate and need not align. These are Google search metrics, separate from AI citations, index checks and browser visits.')}</p>
+    <details><summary className="cursor-pointer">{t('数据来源与统计口径', 'Source and measurement details')}</summary>
+      <p>{t('来源与权限', 'Source and access')}：Google Search Console API · {e.property} · {e.permissionLevel} · {e.credentialMode}</p>
+      <p>{t('官方日界', 'Provider timezone')}：America/Los_Angeles (PT) · dataState=final · Web · auto/byPage</p>
+      <p>{t('日期遵循官方 PT 日界（含夏令时），不按北京时间重新切日。页面只包含 Himax；国家与设备是组合维度，不分别当作两个独立总量。', 'Dates retain provider PT boundaries including daylight saving, without rebucketing to Shanghai. Pages are Himax-only; country/device rows are paired dimensions, not separate totals.')}</p>
+      <p>{t('接口返回热门行，不保证完整总体；明细点击率保留 0–1 比例。以下保留各表官方返回状态，便于核查。', 'The API returns top rows, not a guaranteed complete population. Detail CTR retains the 0–1 ratio. Source report states are retained below.')}</p>
+      {views.map(([key, label]) => <p key={key}>{label}：{e.reports[key].status} · {e.reports[key].response_aggregation_types.join(', ') || t('未返回聚合类型', 'No aggregation type returned')} · {t('触及分页上限', 'Pagination limit reached')}：{e.reports[key].bounded_pagination_limit_reached ? t('是', 'Yes') : t('否', 'No')}</p>)}
+      <p>{t('最近采集尝试', 'Latest collection attempt')}：{e.lastAttempt ? `${e.lastAttempt.at} · ${e.lastAttempt.status}` : t('未记录；不能据此推断任务健康', 'Not recorded; health cannot be inferred')}</p>
+    </details>
+  </div>;
+}
