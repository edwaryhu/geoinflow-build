+import React from 'react';
+import {renderToStaticMarkup} from 'react-dom/server';
+import {describe,it,expect,vi,afterEach} from 'vitest';
+vi.mock('@/lib/liekan/i18n/client',()=>({useLiekanI18n:()=>({locale:'zh-CN'})}));
+import {GscApiEvidence} from './GscApiEvidence';
+import {gscFixture} from '@/lib/liekan/contracts/gsc-api-evidence.fixture';
+afterEach(()=>vi.restoreAllMocks());
+describe('GSC actual API observations',()=>{
+ it('does not label no_rows as zero or assert processing',()=>{const s=renderToStaticMarkup(<GscApiEvidence evidence={gscFixture()}/>);for(const v of ['指标未知','— / — / — / —','America/Los_Angeles (PT)','siteRestrictedUser','定时采集尚未配置'])expect(s).toContain(v);expect(s).not.toContain('官方表现数据处理中。')});
+ it('keeps missing overview when daily observations exist',()=>{const e=gscFixture();e.availability='observed_rows';e.reports.days={...e.reports.days,status:'observed',row_count:1,rows:[{date:'2020-01-01',clicks:0,impressions:2,ctr:0,position:3}]};const s=renderToStaticMarkup(<GscApiEvidence evidence={e}/>);expect(s).toContain('总览未返回');expect(s).toContain('— / — / — / —');expect(s).toContain('2020-01-01')});
+ it('shows source total only when actually returned',()=>{const e=gscFixture();e.availability='observed_rows';e.reports.total={...e.reports.total,status:'observed',row_count:1,rows:[{clicks:0,impressions:8,ctr:0,position:5}]};const s=renderToStaticMarkup(<GscApiEvidence evidence={e}/>);expect(s).toContain('0 / 8 / 0% / 5')});
+ it('shows page and paired country/device evidence without merging denominators',()=>{const e=gscFixture();e.availability='observed_rows';e.reports.pages={...e.reports.pages,status:'observed',row_count:1,rows:[{page:'https://www.himaxtec.com/en/about',page_language_group:'en',clicks:1,impressions:4,ctr:0.25,position:2}]};e.reports.countries_devices={...e.reports.countries_devices,status:'observed',row_count:1,rows:[{country:'usa',device:'MOBILE',clicks:1,impressions:5,ctr:0.2,position:2}]};const s=renderToStaticMarkup(<GscApiEvidence evidence={e}/>);for(const v of ['https://www.himaxtec.com/en/about','页面语言','usa','MOBILE','0.25','0.2','各聚合独立'])expect(s).toContain(v);expect(s).toContain('— / — / — / —')});
+
+ it('flags stale successful observations even when scheduling is configured',()=>{vi.spyOn(Date,'now').mockReturnValue(Date.parse('2020-01-08T00:00:01Z'));const e=gscFixture();e.scheduledExecutionInstalled=true;const s=renderToStaticMarkup(<GscApiEvidence evidence={e}/>);expect(s).toContain('超过 48 小时');expect(s).toContain('配置状态不代表任务正在正常运行')});
+ it('does not mark exactly 48 hours old data stale',()=>{vi.spyOn(Date,'now').mockReturnValue(Date.parse('2020-01-08T00:00:00Z'));const s=renderToStaticMarkup(<GscApiEvidence evidence={gscFixture()}/>);expect(s).not.toContain('超过 48 小时未成功更新')});
+ it('keeps last successful values and clearly marks a later failed attempt',()=>{const e=gscFixture();e.lastAttempt={at:'2020-01-06T01:00:00Z',status:'failed'};const s=renderToStaticMarkup(<GscApiEvidence evidence={e}/>);expect(s).toContain('最近一次采集失败');expect(s).toContain('2020-01-06T01:00:00Z');expect(s).toContain('— / — / — / —')});
+
+});
