+import { z } from 'zod';
+const metric = z.number().finite().nonnegative().nullable();
+const count = z.number().int().nonnegative().safe();
+const row = z.object({
+  date: z.string().date().optional(), page: z.string().url().optional(),
+  page_language_group: z.enum(['zh', 'en', 'unknown']).optional(),
+  country: z.string().max(16).optional(), device: z.string().max(32).optional(),
+  clicks: metric, impressions: metric, ctr: z.number().finite().min(0).max(1).nullable(), position: metric,
+}).strict();
+const report = z.object({
+  status: z.enum(['observed', 'no_rows_returned']), rows: z.array(row).max(1000), row_count: count,
+  bounded_pagination_limit_reached: z.boolean(), response_aggregation_types: z.array(z.enum(['byPage', 'auto'])),
