+/** Offline projection only. No credentials, network, filesystem, or publication. */
+import { createHash } from 'node:crypto';
+import { z } from 'zod';
+import { gscApiEvidenceSchema } from './contracts/gsc-api-evidence';
+import { officialSearchAiSchema } from './contracts/official-search-ai';
+const sha = (text: string) => createHash('sha256').update(text, 'utf8').digest('hex');
+const collectorSchema = z.object({
+  protocol: z.literal('himax-search-readonly-v1'), project: z.literal('himax-homepage'), provider: z.literal('gsc'),
+  property: z.literal('https://www.himaxtec.com/'), collected_at: z.string().datetime({offset:true}),
+  status: z.literal('read_verified'), not_website_deployment: z.literal(true), business_improvement_verified: z.literal(false),
+  permission_level: z.literal('siteRestrictedUser'), window: gscApiEvidenceSchema.shape.window,
+  scope: gscApiEvidenceSchema.shape.scope, reports: gscApiEvidenceSchema.shape.reports,
+  credential_mode: z.object({protocol:z.literal('himax-gsc-service-account-v1'),type:z.literal('service_account'),identity_pins_verified:z.literal(true),property_permission_verified:z.literal('siteRestrictedUser'),scopes_requested:z.tuple([z.literal('https://www.googleapis.com/auth/webmasters.readonly')]),token_persisted_in_evidence:z.literal(false),scheduled_execution_installed:z.boolean()}),
+  data_availability:z.object({status:z.enum(['observed_rows','no_rows_returned']),processing_status:z.literal('unknown_not_reported_by_api'),empty_is_not_zero:z.literal(true),source_data_state_requested:z.literal('final')}),
+});
+export function prepareGscSnapshotCandidate(input: {currentSnapshotJson:string;expectedSnapshotSha256:string;collectorJson:string;preparedAt:string}) {
+  if(input.currentSnapshotJson.length>2_000_000 || input.collectorJson.length>2_000_000)throw new Error('Snapshot preparation exceeds bounded size');
+  if(!/^[a-f0-9]{64}$/.test(input.expectedSnapshotSha256) || sha(input.currentSnapshotJson)!==input.expectedSnapshotSha256)throw new Error('Snapshot changed; reread before preparing');
+  const previous=officialSearchAiSchema.parse(JSON.parse(input.currentSnapshotJson));
+  if(previous.websiteId!=='e7d76cef-2135-4507-a59c-1cc74839aa0a')throw new Error('Only Himax production snapshot is supported');
+  const c=collectorSchema.parse(JSON.parse(input.collectorJson));
+  const preparedAt=z.string().datetime({offset:true}).parse(input.preparedAt);
+  if(Date.parse(c.collected_at)>Date.parse(preparedAt) || Date.parse(previous.preparedAt)>Date.parse(preparedAt))throw new Error('Preparation precedes source observation');
+  const ptDate=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Los_Angeles',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(c.collected_at));
+  if(c.window.end_date_inclusive>=ptDate)throw new Error('Final data window includes current or future PT date');
+  const sourceSha256=sha(input.collectorJson);
+  const apiEvidence=gscApiEvidenceSchema.parse({protocol:'himax-gsc-api-display-v1',property:c.property,collectedAt:c.collected_at,sourceSha256,permissionLevel:c.permission_level,credentialMode:c.credential_mode.type,scheduledExecutionInstalled:c.credential_mode.scheduled_execution_installed,lastAttempt:{at:c.collected_at,status:'read_verified'},window:c.window,scope:c.scope,availability:c.data_availability.status,processingStatus:c.data_availability.processing_status,reports:c.reports});
+  const evidenceFile='gsc-service-account-result.json';
+  const snapshot=officialSearchAiSchema.parse({...previous,preparedAt,refreshMode:'mixed_official_sources',evidence:[...previous.evidence.filter(e=>e.file!==evidenceFile),{file:evidenceFile,sha256:sourceSha256}],gsc:{...previous.gsc,automaticSync:'api_read_verified',performance:apiEvidence.availability,apiEvidence}});
+  // Caller must reread and compare expectedPreviousSha256 again under a lock
+  // immediately before an atomic private-file replacement. This function does no I/O.
+  const candidateJson=JSON.stringify(snapshot,null,2)+'\n';
+  if(Buffer.byteLength(candidateJson,'utf8')>512*1024)throw new Error('Candidate exceeds existing private snapshot reader limit');
+  return {candidateJson,candidateSha256:sha(candidateJson),expectedPreviousSha256:input.expectedSnapshotSha256,sourceSha256};
+}
