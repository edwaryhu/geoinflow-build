+  const anyRows=Object.values(e.reports).some(r=>r.rows.length>0);
+  if(anyRows!==(e.availability==='observed_rows'))ctx.addIssue({code:'custom',message:'Availability mismatch'});
+  for(const [name,r] of Object.entries(e.reports)) {
+    const keys=new Set<string>();
+    for(const v of r.rows) {
+      const dimensions=Object.keys(v).filter(k=>!['clicks','impressions','ctr','position','page_language_group'].includes(k)).sort();
+      const expected=({total:[],days:['date'],pages:['page'],countries_devices:['country','device']} as Record<string,string[]>)[name];
+      if(JSON.stringify(dimensions)!==JSON.stringify(expected))ctx.addIssue({code:'custom',message:'Dimension mismatch'});
+      if(v.date && (v.date<start || v.date>end))ctx.addIssue({code:'custom',message:'Date outside requested window'});
+      if(v.page) { try { const u=new URL(v.page); if(u.protocol!=='https:' || !['himaxtec.com','www.himaxtec.com'].includes(u.host) || u.search || u.hash || u.username || u.password)ctx.addIssue({code:'custom',message:'Page outside Himax'}); } catch { ctx.addIssue({code:'custom',message:'Invalid page URL'}); } }
+      const key=JSON.stringify(expected.map(k=>(v as Record<string,unknown>)[k]));
+      if(keys.has(key))ctx.addIssue({code:'custom',message:'Duplicate aggregate row'});keys.add(key);
+    }
+  }
+});
+export type GscApiEvidence=z.infer<typeof gscApiEvidenceSchema>;
