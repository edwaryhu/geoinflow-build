+  for(const field of ['bingSearch','bingAi','chatgpt','observedAt','selectedWindow','exportDate'])expect(after[field]).toEqual(before[field]);
+  expect(after.gsc.checkedAt).toBe(before.gsc.checkedAt);expect(after.gsc.clicks).toBeNull();expect(after.gsc.apiEvidence.reports.total.rows).toEqual([]);expect(after.gsc.automaticSync).toBe('api_read_verified');expect(after.gsc.apiEvidence.scheduledExecutionInstalled).toBe(false);
