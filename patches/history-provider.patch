+// Report pages are outside FeatureProvider; bind the read to their authorized root identity.
+export function VercelHistory({ userId, websiteId }: { userId: string; websiteId: string }) {
+  const api = useApi();
+  const query = api.useQuery<VercelHistoryResponse>({
+    queryKey: ['liekan-feature', userId, 'vercel-history', websiteId],
+    queryFn: ({ signal }) => featureApi.get(`/liekan/websites/${websiteId}/vercel-history`, {}, signal),
+    enabled: !!userId && !!websiteId,
+    staleTime: 300000,
+    retry: false,
+    placeholderData: undefined,
+  });
+  // Do not expose retained data after denied/failed reads or from a different website.
+  const mismatch = query.data?.state === 'available' && query.data.snapshot.websiteId !== websiteId;
+  return <VercelHistoryCard
+    response={userId && websiteId && !mismatch ? query.data : undefined}
+    failed={!!query.error || mismatch}
+  />;
 }
 
