+      formatValue={value => value.toFixed(3)} />);
+    expect(screen.getByText('—')).toBeTruthy();
+    expect(screen.getByText('No data available')).toBeTruthy();
+    expect(screen.queryByText('Good')).toBeNull();
+    expect(screen.queryByText('0.000')).toBeNull();
+  });
