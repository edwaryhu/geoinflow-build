+/** Preserve missing/non-finite measurements and retain valid zero (for example CLS=0). */
+export function performanceValue(value: unknown): number | null {
+  if (value == null || (typeof value === 'string' && value.trim() === '')) return null;
+  const numeric = Number(value);
+  return Number.isFinite(numeric) ? numeric : null;
+}
