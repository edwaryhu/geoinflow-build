+// @vitest-environment node
+// Only an explicitly supplied disposable loopback database may run this test.
+import { randomUUID } from 'node:crypto';
+import { afterAll, beforeAll, beforeEach, describe, expect, test, vi } from 'vitest';
+import { getFunnel } from './getFunnel';
+
+const { db } = vi.hoisted(() => ({ db: { client: null as any } }));
+vi.mock('@/lib/db', () => ({
+  CLICKHOUSE: 'clickhouse', PRISMA: 'prisma',
+  runQuery: (queries: Record<string, () => unknown>) => queries.prisma(),
+}));
+vi.mock('@/lib/clickhouse', () => ({ default: {} }));
+vi.mock('@/lib/prisma', () => ({ default: {
+  parseFilters: ({ websiteId, startDate, endDate }: any) => ({
+    queryParams: { websiteId, startDate, endDate },
+    filterQuery: '', joinSessionQuery: '', cohortQuery: '',
+  }),
+  getAddIntervalQuery: (column: string, interval: string) => {
+    if (interval !== '30 minute') throw new Error('Unexpected test interval');
+    return `${column} + interval '30 minute'`;
+  },
+  rawQuery: async (query: string, params: Record<string, unknown>) => {
+    const values: unknown[] = [];
+    const sql = query.replace(/\{\{(\w+)(::uuid)?\}\}/g, (_match, key, cast) => {
+      if (!(key in params)) throw new Error('Missing parameter');
+      values.push(params[key]);
+      return `$${values.length}${cast || ''}`;
+    });
+    return (await db.client.query(sql, values)).rows;
+  },
+} }));
+
+const connection = process.env.HIMAX_GEO_PATCH_TEST_PG;
+const websiteId = '00000000-0000-4000-8000-000000000001';
+const parameters = {
+  startDate: new Date('2026-11-04T00:00:00Z'),
+  endDate: new Date('2026-11-04T01:00:00Z'), window: 30,
+};
+
+describe.skipIf(!connection)('getFunnel actual PostgreSQL event semantics', () => {
+  beforeAll(async () => {
+    const url = new URL(connection!);
+    if (!['localhost', '127.0.0.1', '[::1]'].includes(url.hostname)
+      || !/^\/[a-z0-9_]+_patch_test$/.test(url.pathname)) {
+      throw new Error('Only a disposable loopback *_patch_test database is allowed');
+    }
+    const { Client } = await import('pg');
+    db.client = new Client({ connectionString: connection });
+    await db.client.connect();
+    await db.client.query(`SET statement_timeout='3s'; SET jit=off`);
+    // Temporary connection-local table shadows no existing production table.
+    await db.client.query(`CREATE TEMP TABLE website_event (
+      website_id uuid NOT NULL, session_id uuid NOT NULL,
+      created_at timestamptz NOT NULL, event_type integer NOT NULL,
+      url_path text, event_name text
+    )`);
+  });
+  afterAll(async () => { if (db.client) await db.client.end(); });
+  beforeEach(async () => { await db.client.query('TRUNCATE TABLE pg_temp.website_event'); });
+
+  async function session(events: Array<[number, string, string | null]>) {
+    const sessionId = randomUUID();
+    for (const [index, [type, path, name]] of events.entries()) {
+      await db.client.query(`INSERT INTO pg_temp.website_event
+        (website_id, session_id, created_at, event_type, url_path, event_name)
+        VALUES ($1, $2, $3, $4, $5, $6)`,
+      [websiteId, sessionId, new Date(parameters.startDate.getTime() + index * 1000),
+        type, path, name]);
+    }
+  }
+
+  test('custom-only and performance events do not qualify as landing pageviews', async () => {
+    await session([[1, '/landing', null], [2, '/landing', 'contact_open']]);
+    await session([[2, '/landing', 'contact_open']]);
+    await session([[5, '/landing', null], [2, '/landing', 'contact_open']]);
+    await session([[1, '/landing', null], [1, '/other', 'contact_open']]);
+    const result = await getFunnel(websiteId, { ...parameters, steps: [
+      { type: 'path', value: '/landing' }, { type: 'event', value: 'contact_open' },
+    ] }, {});
+    expect(result.map(row => row.visitors)).toEqual([2, 1]);
+    expect(result[1].remaining).toBe(0.5);
+  });
+
+  test('later path steps require pageviews and first event steps require custom events', async () => {
+    await session([[2, '/form', 'contact_open'], [1, '/thanks', null]]);
+    await session([[2, '/form', 'contact_open'], [2, '/thanks', 'something_else']]);
+    await session([[1, '/form', 'contact_open'], [1, '/thanks', null]]);
+    const result = await getFunnel(websiteId, { ...parameters, steps: [
+      { type: 'event', value: 'contact_open' }, { type: 'path', value: '/thanks' },
+    ] }, {});
+    expect(result.map(row => row.visitors)).toEqual([2, 1]);
+  });
+});
