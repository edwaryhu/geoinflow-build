+import { beforeEach, describe, expect, it, vi } from 'vitest';
+const { openMock } = vi.hoisted(() => ({ openMock: vi.fn() }));
+vi.mock('node:fs/promises', () => ({ open: openMock }));
+import { readOfficialSearchAi } from './official-search-ai';
+import { officialFixture, fixtureWebsite } from '../contracts/official-search-ai.fixture';
+beforeEach(() => vi.clearAllMocks());
+function file(data: unknown, size?: number) {
+  const b = Buffer.from(JSON.stringify(data)); const close = vi.fn();
+  openMock.mockResolvedValue({ stat: async () => ({ isFile: () => true, size: size ?? b.length }),
+    read: async (buffer: Buffer) => { b.copy(buffer); return { bytesRead: b.length }; }, close });
+  return close;
+}
+describe('official snapshot private file boundary', () => {
+  it('reads authorized UUID from the fixed directory and closes', async () => {
+    const close = file(officialFixture()); expect((await readOfficialSearchAi(fixtureWebsite)).state).toBe('available');
+    expect(openMock.mock.calls[0][0]).toContain(`/managed-geo/official-search-ai-${fixtureWebsite}.json`);
+    expect(close).toHaveBeenCalledOnce();
+  });
+  it('does not open path traversal input', async () => { expect((await readOfficialSearchAi('../x')).state).toBe('unavailable'); expect(openMock).not.toHaveBeenCalled(); });
+  it('missing file remains not connected', async () => { openMock.mockRejectedValue({ code: 'ENOENT' }); expect(await readOfficialSearchAi(fixtureWebsite)).toEqual({ state: 'not_connected', snapshot: null }); });
+  it('rejects another website snapshot', async () => { file({ ...officialFixture(), websiteId: '22222222-2222-4222-8222-222222222222' }); expect((await readOfficialSearchAi(fixtureWebsite)).snapshot).toBeNull(); });
+  it('refuses oversized files', async () => { const close = file(officialFixture(), 524289); expect((await readOfficialSearchAi(fixtureWebsite)).state).toBe('unavailable'); expect(close).toHaveBeenCalledOnce(); });
+  it('refuses symlinks', async () => { openMock.mockRejectedValue({ code: 'ELOOP' }); expect((await readOfficialSearchAi(fixtureWebsite)).state).toBe('unavailable'); });
+  it('refuses future prepared times', async () => { file({ ...officialFixture(), preparedAt: '2099-01-01T00:00:00Z' }); expect((await readOfficialSearchAi(fixtureWebsite)).state).toBe('unavailable'); });
+});
