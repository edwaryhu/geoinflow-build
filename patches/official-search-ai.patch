@@ -0,0 +1,55 @@
+import { z } from 'zod';
+const count = z.number().int().nonnegative().safe();
+const date = z.string().date();
+const instant = z.string().datetime({ offset: true });
+const windowSchema = z.object({ start: date, endInclusive: date }).strict()
+  .refine(w => w.start <= w.endInclusive, 'Invalid date window');
+const table = z.object({
+  columns: z.array(z.string().max(100)).min(1).max(8),
+  rows: z.array(z.array(z.string().max(2048)).max(8)).max(1000),
+}).strict().refine(t => t.rows.every(row => row.length === t.columns.length), 'Table shape mismatch');
+const availableSearch = z.object({
+  state: z.literal('available'), exportWindow: windowSchema, sourceTimezone: z.string().max(80).nullable(),
+  missingSelectedDates: z.array(date).max(366), clicks: count, impressions: count,
+  ctrDisplay: z.string().max(40), totalScope: z.literal('All'), dimensionScope: z.literal('Web'),
+  daily: table, pages: table, queries: table, countries: table, devices: table,
+}).strict();
+const availableAi = z.object({
+  state: z.literal('available'), exportWindow: windowSchema, sourceTimezone: z.string().max(80).nullable(),
+  missingSelectedDates: z.array(date).max(366), citations: count,
+  averageCitedPagesDisplay: z.string().max(40), citationShareDenominator: z.null(),
+  daily: table, pages: table, groundingQueries: table,
+  allPositiveDatesBeforeProjectStart: z.boolean(),
+}).strict();
+const unavailable = z.object({ state: z.enum(['not_connected', 'processing', 'unavailable']), reason: z.string().max(400) }).strict();
+export const officialSearchAiSchema = z.object({
+  version: z.literal(1), websiteId: z.uuid(), hostname: z.enum(['himaxtec.com', 'www.himaxtec.com']),
+  provider: z.literal('Official webmaster reports'),
+  preparedAt: instant, observedAt: instant.nullable(), exportDate: date, refreshMode: z.literal('manual_official_snapshot'),
+  selectedWindow: windowSchema,
+  evidence: z.array(z.object({ file: z.string().regex(/^[A-Za-z0-9_.-]{1,160}$/), sha256: z.string().regex(/^[a-f0-9]{64}$/) }).strict()).min(1).max(20),
+  bingSearch: z.union([availableSearch, unavailable]), bingAi: z.union([availableAi, unavailable]),
+  gsc: z.object({
+    ownership: z.enum(['verified', 'not_verified', 'unknown']),
+    performance: z.enum(['processing', 'not_connected', 'unavailable']),
+    automaticSync: z.enum(['deferred_mfa', 'not_connected', 'awaiting_authorization']),
+    homepageIndexed: z.boolean().nullable(), sitemapDiscoveredUrls: count.nullable(), checkedAt: instant.nullable(),
+    clicks: z.null(), impressions: z.null(), citations: z.null(),
+  }).strict(),
+  chatgpt: z.object({ state: z.literal('not_sampled'), citations: z.null() }).strict(),
+}).strict().superRefine((s, ctx) => {
+  const end = s.selectedWindow.endInclusive;
+  for (const v of [s.bingSearch, s.bingAi]) {
+    if (v.state !== 'available') continue;
+    if (v.exportWindow.start < s.selectedWindow.start || v.exportWindow.endInclusive > end)
+      ctx.addIssue({ code: 'custom', message: 'Export window outside selected dates' });
+    if (new Set(v.missingSelectedDates).size !== v.missingSelectedDates.length ||
+        v.missingSelectedDates.some(d => d < s.selectedWindow.start || d > end))
+      ctx.addIssue({ code: 'custom', message: 'Invalid missing selected dates' });
+  }
+  if (s.observedAt && Date.parse(s.observedAt) > Date.parse(s.preparedAt))
+    ctx.addIssue({ code: 'custom', message: 'Observation after preparation' });
+});
+export type OfficialSearchAiSnapshot = z.infer<typeof officialSearchAiSchema>;
+export type OfficialSearchAiResponse = { state: 'available'; snapshot: OfficialSearchAiSnapshot }
+  | { state: 'not_connected' | 'unavailable'; snapshot: null };
