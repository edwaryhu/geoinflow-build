+import React from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+const mocks = vi.hoisted(() => ({ locale: 'zh-CN', query: { data: undefined as any, error: null as any }, options: undefined as any, get: vi.fn() }));
+vi.mock('@/components/hooks/useApi', () => ({ useApi: () => ({ useQuery: (opts: unknown) => { mocks.options = opts; return mocks.query; } }) }));
+vi.mock('@/lib/liekan/upstream/features-client', () => ({ featureApi: { get: mocks.get } }));
+vi.mock('@/lib/liekan/i18n/client', () => ({ useLiekanI18n: () => ({ locale: mocks.locale }) }));
+import { OfficialSearchAi, OfficialSearchAiCard } from './OfficialSearchAi';
+import { officialFixture, fixtureWebsite } from '@/lib/liekan/contracts/official-search-ai.fixture';
+beforeEach(() => { mocks.locale = 'zh-CN'; mocks.query = { data: undefined, error: null }; mocks.get.mockClear(); });
+describe('independent official source card', () => {
+  it('shows unknown source as unavailable rather than zero', () => {
+    const html = renderToStaticMarkup(<OfficialSearchAiCard response={{ state: 'not_connected', snapshot: null }} />);
+    expect(html).toContain('尚未导入'); expect(html).not.toContain('0 次');
+  });
+  it('shows all official detail sections and keeps source windows and sampling limits', () => {
+    const html = renderToStaticMarkup(<OfficialSearchAiCard response={{ state: 'available', snapshot: officialFixture() }} />);
+    for (const x of ['7 次官方引用', '3 点击', '8 展示', '关键词（Web）', '地区（Web', '设备（Web）', '每日搜索数据', '每日 AI 引用', '12.34%', '分母未知', '未知（保留原始日期）', '2020-01-04', '— / — / —', '早于本轮 GEO']) expect(html).toContain(x);
+  });
+  it('does not preserve stale values after a failed read', () => {
+    const html = renderToStaticMarkup(<OfficialSearchAiCard response={{ state: 'available', snapshot: officialFixture() }} failed />);
+    expect(html).not.toContain('7 次官方引用'); expect(html).toContain('读取失败');
+  });
+  it('supports English display', () => {
+    mocks.locale = 'en-US'; const html = renderToStaticMarkup(<OfficialSearchAiCard response={{ state: 'available', snapshot: officialFixture() }} />);
+    expect(html).toContain('Official search and AI citations'); expect(html).toContain('Unknown (original dates retained)');
+  });
+  it('renders provider text safely without HTML execution', () => {
+    const s = officialFixture(); if (s.bingAi.state === 'available') s.bingAi.groundingQueries.rows[0][0] = '<img src=x onerror=bad()>';
+    const html = renderToStaticMarkup(<OfficialSearchAiCard response={{ state: 'available', snapshot: s }} />);
+    expect(html).toContain('&lt;img'); expect(html).not.toContain('<img src=x');
+  });
+  it('scopes cache and request to the current identity', async () => {
+    renderToStaticMarkup(<OfficialSearchAi userId="synthetic-user" websiteId={fixtureWebsite} />);
+    expect(mocks.options.queryKey).toEqual(['liekan-feature', 'synthetic-user', 'official-search-ai', fixtureWebsite]);
+    const signal = new AbortController().signal; await mocks.options.queryFn({ signal });
+    expect(mocks.get).toHaveBeenCalledWith(`/liekan/websites/${fixtureWebsite}/official-search-ai`, {}, signal);
+  });
+  it('hides mismatched website values', () => {
+    mocks.query.data = { state: 'available', snapshot: officialFixture() };
+    const html = renderToStaticMarkup(<OfficialSearchAi userId="synthetic-user" websiteId="22222222-2222-4222-8222-222222222222" />);
+    expect(html).not.toContain('7 次官方引用'); expect(html).toContain('读取失败');
+  });
+});
