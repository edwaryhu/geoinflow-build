+import { api } from '@/lib/liekan/http';
+import { authorize } from '@/lib/liekan/upstream/server';
+import { readOfficialSearchAi } from '@/lib/liekan/upstream/official-search-ai';
+export async function GET(request: Request, { params }: { params: Promise<{ websiteId: string }> }) {
+  return api(async () => {
+    const { websiteId } = await params;
+    const { website } = await authorize(request, websiteId);
+    return readOfficialSearchAi(website.id);
+  });
+}
