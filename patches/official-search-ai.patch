+      citations: 7, averageCitedPagesDisplay: '0', citationShareDenominator: null, daily: table, pages: table,
+      groundingQueries: { columns: ['Grounding Query', 'Citations', 'Citation Share'], rows: [['synthetic query', '2', '12.34%']] }, allPositiveDatesBeforeProjectStart: true },
+    gsc: { ownership: 'verified', performance: 'processing', automaticSync: 'awaiting_authorization', homepageIndexed: true, sitemapDiscoveredUrls: 2,
+      checkedAt: '2020-01-06T11:00:00+08:00', clicks: null, impressions: null, citations: null },
+    chatgpt: { state: 'not_sampled', citations: null },
+  };
+}
