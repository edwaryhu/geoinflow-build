+      </div>
+      <p className="text-[12px] text-sub">{t('官方导出有处理延迟与抽样限制；缺失日不补 0。所有数据保持独立来源，不并入浏览器 PV/UV、爬虫请求、GEO 权重或转化。', 'Official exports have processing delays and sampling limits. Missing days stay unknown. These data are separate from browser PV/UV, crawler requests, GEO weight and conversions.')}</p>
+    </>}
+  </section>;
+}
+function WindowNote({ value, t }: { value: { exportWindow: { start: string; endInclusive: string }; sourceTimezone: string | null; missingSelectedDates: string[] }; t: (zh: string, en: string) => string }) {
+  return <p className="text-[12px] text-sub">{t('CSV 实际日期', 'Actual CSV dates')}：{value.exportWindow.start} – {value.exportWindow.endInclusive} · {t('来源时区', 'Source timezone')}：{value.sourceTimezone ?? t('未知（保留原始日期）', 'Unknown (original dates retained)')}
+    {value.missingSelectedDates.length > 0 && <><br />{t('所选窗口缺失日期', 'Missing dates in selected window')}：{value.missingSelectedDates.join(', ')}（{t('未知，非 0', 'unknown, not zero')}）</>}</p>;
+}
+function Rows({ title, value }: { title: string; value: { columns: string[]; rows: string[][] } }) {
+  return <details className="text-[12px]"><summary className="cursor-pointer">{title} ({value.rows.length})</summary>
+    <div className="overflow-x-auto max-h-80 overflow-y-auto"><table className="w-full text-left mt-2"><caption className="sr-only">{title}</caption>
+      <thead><tr>{value.columns.map((c, i) => <th key={i} className="p-2 border-b border-line">{c}</th>)}</tr></thead>
+      <tbody>{value.rows.map((row, i) => <tr key={i}>{row.map((cell, j) => <td key={j} className="p-2 border-b border-line break-words">{cell}</td>)}</tr>)}</tbody>
+    </table></div></details>;
+}
