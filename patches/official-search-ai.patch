+import { describe, expect, it } from 'vitest';
+import { officialSearchAiSchema } from './official-search-ai';
+import { officialFixture } from './official-search-ai.fixture';
+describe('official snapshots remain separate evidence', () => {
+  it('retains unknown timezone, missing days and reported share without reconciliation', () => {
+    const s = officialSearchAiSchema.parse(officialFixture());
+    expect(s.bingAi.state === 'available' && s.bingAi.averageCitedPagesDisplay).toBe('0');
+    expect(s.bingAi.state === 'available' && s.bingAi.citationShareDenominator).toBeNull();
+    expect(s.bingSearch.state === 'available' && s.bingSearch.sourceTimezone).toBeNull();
+    expect(s.gsc.clicks).toBeNull(); expect(s.chatgpt.citations).toBeNull();
+  });
+  it.each([{ websiteId: '../escape' }, { hostname: 'other.example' }, { provider: 'Crawler logs' }, { privateToken: 'synthetic' },
+    { refreshMode: 'live' }, { observedAt: '2099-01-01T00:00:00Z' }])('rejects wrong scope or misleading metadata %j', bad => {
+    expect(officialSearchAiSchema.safeParse({ ...officialFixture(), ...bad }).success).toBe(false);
+  });
+  it('rejects invented GSC metrics', () => {
+    const s = officialFixture(); (s.gsc as unknown as Record<string, unknown>).clicks = 0;
+    expect(officialSearchAiSchema.safeParse(s).success).toBe(false);
+  });
+  it('rejects fabricated AI share denominator', () => {
+    const s = officialFixture(); if (s.bingAi.state === 'available') (s.bingAi as unknown as Record<string, unknown>).citationShareDenominator = 999;
+    expect(officialSearchAiSchema.safeParse(s).success).toBe(false);
+  });
+  it('rejects broken table shapes', () => {
+    const s = officialFixture(); if (s.bingSearch.state === 'available') s.bingSearch.pages = { columns: ['x'], rows: [['a', 'b']] };
+    expect(officialSearchAiSchema.safeParse(s).success).toBe(false);
+  });
+  it('rejects out-of-window date claims', () => {
+    const s = officialFixture(); if (s.bingAi.state === 'available') s.bingAi.exportWindow.endInclusive = '2020-02-01';
+    expect(officialSearchAiSchema.safeParse(s).success).toBe(false);
+  });
+  it('keeps unavailable sources without zero-filled data', () => {
+    const s = officialFixture(); s.bingAi = { state: 'not_connected', reason: 'No official export yet' };
+    expect(officialSearchAiSchema.parse(s).bingAi).toEqual(s.bingAi);
