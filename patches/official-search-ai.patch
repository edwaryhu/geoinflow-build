+import { beforeEach, describe, expect, it, vi } from 'vitest';
+const mocks = vi.hoisted(() => ({ authorize: vi.fn(), read: vi.fn() }));
+vi.mock('@/lib/liekan/http', () => ({ api: (f: () => Promise<unknown>) => f() }));
+vi.mock('@/lib/liekan/upstream/server', () => ({ authorize: mocks.authorize }));
+vi.mock('@/lib/liekan/upstream/official-search-ai', () => ({ readOfficialSearchAi: mocks.read }));
+import { GET } from './route';
+beforeEach(() => vi.resetAllMocks());
+describe('official report read authorization', () => {
+  it('never loads a snapshot after denied access', async () => {
+    mocks.authorize.mockRejectedValue(new Error('denied'));
+    await expect(GET(new Request('https://example.invalid/'), { params: Promise.resolve({ websiteId: '101' }) })).rejects.toThrow('denied');
+    expect(mocks.read).not.toHaveBeenCalled();
+  });
+  it('uses the existing authorization-resolved UUID', async () => {
+    mocks.authorize.mockResolvedValue({ website: { id: '11111111-1111-4111-8111-111111111111' } });
+    await GET(new Request('https://example.invalid/'), { params: Promise.resolve({ websiteId: '101' }) });
+    expect(mocks.read).toHaveBeenCalledWith('11111111-1111-4111-8111-111111111111');
+  });
+});
