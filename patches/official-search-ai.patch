--- /dev/null
+++ b/src/lib/liekan/upstream/official-search-ai.ts
@@ -0,0 +1,24 @@
+import { constants } from 'node:fs';
+import { open } from 'node:fs/promises';
+import path from 'node:path';
+import { z } from 'zod';
+import { officialSearchAiSchema, type OfficialSearchAiResponse } from '../contracts/official-search-ai';
+const LIMIT = 512 * 1024;
+export async function readOfficialSearchAi(websiteId: string): Promise<OfficialSearchAiResponse> {
+  if (!z.uuid().safeParse(websiteId).success) return { state: 'unavailable', snapshot: null };
+  let file: Awaited<ReturnType<typeof open>> | undefined;
+  try {
+    file = await open(path.join(process.cwd(), 'managed-geo', `official-search-ai-${websiteId}.json`), constants.O_RDONLY | constants.O_NOFOLLOW);
+    const stat = await file.stat();
+    if (!stat.isFile() || stat.size > LIMIT) throw new Error('Invalid official snapshot file');
+    const buffer = Buffer.alloc(LIMIT + 1);
+    const { bytesRead } = await file.read(buffer, 0, buffer.length, 0);
+    if (bytesRead > LIMIT) throw new Error('Official snapshot exceeds limit');
+    const snapshot = officialSearchAiSchema.parse(JSON.parse(buffer.subarray(0, bytesRead).toString('utf8')));
+    if (snapshot.websiteId !== websiteId || Date.parse(snapshot.preparedAt) > Date.now() + 60000)
+      throw new Error('Official snapshot identity/date mismatch');
+    return { state: 'available', snapshot };
+  } catch (error) {
+    return { state: (error as NodeJS.ErrnoException)?.code === 'ENOENT' ? 'not_connected' : 'unavailable', snapshot: null };
+  } finally { await file?.close(); }
+}
