+'use client';
+import { useApi } from '@/components/hooks/useApi';
+import { featureApi } from '@/lib/liekan/upstream/features-client';
+import { useLiekanI18n } from '@/lib/liekan/i18n/client';
+import type { OfficialSearchAiResponse } from '@/lib/liekan/contracts/official-search-ai';
+export function OfficialSearchAi({ userId, websiteId }: { userId: string; websiteId: string }) {
+  const api = useApi();
+  const query = api.useQuery<OfficialSearchAiResponse>({
+    queryKey: ['liekan-feature', userId, 'official-search-ai', websiteId],
+    queryFn: ({ signal }) => featureApi.get(`/liekan/websites/${websiteId}/official-search-ai`, {}, signal),
+    enabled: !!userId && !!websiteId, staleTime: 300000, retry: false, placeholderData: undefined,
+  });
+  const mismatch = query.data?.state === 'available' && query.data.snapshot.websiteId !== websiteId;
+  return <OfficialSearchAiCard response={userId && websiteId && !mismatch ? query.data : undefined} failed={!!query.error || mismatch} onRefresh={() => void query.refetch()} />;
+}
+export function OfficialSearchAiCard({ response, failed = false, onRefresh }: { response?: OfficialSearchAiResponse; failed?: boolean; onRefresh?: () => void }) {
+  const { locale } = useLiekanI18n();
+  const t = (zh: string, en: string) => locale === 'en-US' ? en : zh;
+  if (!response && !failed) return null;
+  const s = !failed && response?.state === 'available' ? response.snapshot : null;
+  return <section className="card p-5 space-y-4" aria-label={t('官方搜索与 AI 引用', 'Official search and AI citations')}>
+    <header className="flex items-start justify-between gap-3"><div><h2 className="text-[14px] font-bold">{t('官方搜索与 AI 引用', 'Official search and AI citations')}</h2>
+      <p className="text-[12px] text-sub mt-1">{t('独立官方快照 · 非实时 · 不随上方日期筛选变化', 'Separate official snapshot · not live · independent of the date filter above')}</p></div>{onRefresh && <button type="button" className="px-3 py-1.5 rounded-md border border-line text-[12px]" onClick={onRefresh}>{t('刷新快照', 'Refresh snapshot')}</button>}</header>
+    {!s ? <p className="text-[12px] text-sub">{response?.state === 'not_connected' && !failed ? t('尚未导入官方快照，指标未按 0 处理。', 'No official snapshot imported. Missing metrics are not zero.') : t('官方快照读取失败，未显示旧值或按 0 处理。', 'Official snapshot unavailable. Stale values are hidden; missing metrics are not zero.')}</p> : <>
+      <p className="text-[12px] text-sub">{s.hostname} · {t('官方页面所选范围', 'Selected provider range')}：{s.selectedWindow.start} – {s.selectedWindow.endInclusive}<br />
+        {t('官方导出日期', 'Official export date')}：{s.exportDate} · {t('整理时间', 'Prepared at')}：{s.preparedAt} · {t('官方页面读取时间', 'Provider observed at')}：{s.observedAt ?? t('未记录', 'Not recorded')}</p>
+      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
+        <div className="rounded-lg border border-line p-4 space-y-3"><h3 className="font-bold text-[13px]">Bing Search Performance</h3>
+          {s.bingSearch.state !== 'available' ? <p>{s.bingSearch.reason}</p> : <>
+            <p className="text-[18px] font-bold">{s.bingSearch.clicks} {t('点击', 'clicks')} · {s.bingSearch.impressions} {t('展示', 'impressions')} · CTR {s.bingSearch.ctrDisplay}</p>
+            <WindowNote value={s.bingSearch} t={t} />
+            <p className="text-[12px] text-sub">{t('总览来源：All。关键词、页面、地区、设备仅 Web，不含 Chat；各视图分母独立，明细不强行与总览相加对齐。', 'Overview: All. Query, page, country and device views: Web only, excluding Chat. Each view keeps its own denominator.')}</p>
+            <Rows title={t('每日搜索数据（All）', 'Daily search (All)')} value={s.bingSearch.daily} />
+            <Rows title={t('页面（Web）', 'Pages (Web)')} value={s.bingSearch.pages} />
+            <Rows title={t('关键词（Web）', 'Queries (Web)')} value={s.bingSearch.queries} />
+            <Rows title={t('地区（Web；保留官方代码）', 'Countries (Web; provider codes)')} value={s.bingSearch.countries} />
+            <Rows title={t('设备（Web）', 'Devices (Web)')} value={s.bingSearch.devices} />
+          </>}
+        </div>
+        <div className="rounded-lg border border-line p-4 space-y-3"><h3 className="font-bold text-[13px]">Bing AI Performance</h3>
+          {s.bingAi.state !== 'available' ? <p>{s.bingAi.reason}</p> : <>
+            <p className="text-[18px] font-bold">{s.bingAi.citations} {t('次官方引用', 'official citations')}</p>
+            <WindowNote value={s.bingAi} t={t} />
+            <p className="text-[12px] text-sub">{t('官方界面“平均被引用页面”显示', 'Provider average cited pages display')}：{s.bingAi.averageCitedPagesDisplay}。{t('保留原显示精度，不自行重算。', 'Display precision retained; not recalculated.')}</p>
+            <p className="text-[12px] text-sub">{t('覆盖 Copilot、Bing AI 及支持的伙伴体验；不是 ChatGPT 排名、抓取次数、访问或询盘。Grounding query 是归纳检索词，分享比例按官方原值保留，分母未知。', 'Covers Copilot, Bing AI and supported partner experiences. These are not ChatGPT rankings, crawls, visits or leads. Grounding queries are grouped phrases; citation share is retained as reported with an unknown denominator.')}</p>
+            {s.bingAi.allPositiveDatesBeforeProjectStart && <p className="text-[12px] text-sub">{t('本快照的所有非零引用日期早于本轮 GEO 项目开始，作为既有表现，不认定为本轮优化效果。', 'All positive citation dates in this snapshot predate this GEO project. They show existing visibility, not effects of these changes.')}</p>}
+            <Rows title={t('每日 AI 引用', 'Daily AI citations')} value={s.bingAi.daily} />
+            <Rows title={t('被引用页面', 'Cited pages')} value={s.bingAi.pages} />
+            <Rows title={t('Grounding queries 与官方 Citation Share', 'Grounding queries and reported Citation Share')} value={s.bingAi.groundingQueries} />
+          </>}
+        </div>
+      </div>
+      <div className="text-[12px] text-sub space-y-1"><h3 className="font-bold">Google Search Console</h3>
+        <p>{s.gsc.ownership === 'verified' ? t('属性所有权已验证。', 'Property ownership verified.') : t('属性所有权尚未确认。', 'Property ownership not confirmed.')}
+          {s.gsc.performance === 'processing' ? t('官方表现数据处理中。', 'Performance data is processing.') : t('表现数据尚未接入。', 'Performance metrics are not connected.')}
+          {s.gsc.automaticSync === 'deferred_mfa' ? t('自动 API 同步按用户决定暂缓（Google Cloud 要求 MFA）。', 'Automatic API sync deferred by the owner because Google Cloud requires MFA.') : t('自动同步未接通。', 'Automatic sync is not connected.')}</p>
+        <p>{t('首页已索引', 'Homepage indexed')}：{s.gsc.homepageIndexed === null ? t('未知', 'Unknown') : s.gsc.homepageIndexed ? t('是', 'Yes') : t('否', 'No')} · {t('Sitemap 已发现 URL', 'Sitemap discovered URLs')}：{s.gsc.sitemapDiscoveredUrls ?? '—'} · {t('点击 / 展示 / AI 引用', 'Clicks / impressions / AI citations')}：— / — / —</p>
