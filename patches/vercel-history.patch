+import { constants } from 'node:fs';
+import { open } from 'node:fs/promises';
+import path from 'node:path';
+import { z } from 'zod';
+import { vercelHistorySchema, type VercelHistoryResponse } from '../contracts/vercel-history';
+
+export async function readVercelHistory(websiteId: string): Promise<VercelHistoryResponse> {
+  if (!z.uuid().safeParse(websiteId).success) return { state: 'unavailable', snapshot: null };
+  let file: Awaited<ReturnType<typeof open>> | undefined;
+  try {
+    // Fixed directory; UUID is resolved by the existing authorization layer.
+    file = await open(path.join(process.cwd(), 'managed-geo', `vercel-history-${websiteId}.json`),
+      constants.O_RDONLY | constants.O_NOFOLLOW);
+    const stat = await file.stat();
+    if (!stat.isFile() || stat.size > 65536) throw new Error('Invalid snapshot file');
+    const buffer = Buffer.alloc(65537);
+    const { bytesRead } = await file.read(buffer, 0, buffer.length, 0);
+    if (bytesRead > 65536) throw new Error('Snapshot exceeds limit');
+    const snapshot = vercelHistorySchema.parse(JSON.parse(buffer.subarray(0, bytesRead).toString('utf8')));
+    if (snapshot.websiteId !== websiteId || Date.parse(snapshot.collectedAt) > Date.now() + 60000)
+      throw new Error('Snapshot scope or date mismatch');
+    return { state: 'available', snapshot };
+  } catch (error) {
+    return { state: (error as NodeJS.ErrnoException)?.code === 'ENOENT' ? 'not_connected' : 'unavailable', snapshot: null };
+  } finally { await file?.close(); }
+}
