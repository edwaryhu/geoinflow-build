+'use client';
+import { useData, useFeature } from './context';
+import { useLiekanI18n } from '@/lib/liekan/i18n/client';
+import type { VercelHistoryResponse } from '@/lib/liekan/contracts/vercel-history';
+
+export function VercelHistory() {
+  const c = useFeature();
+  return c?.siteId ? <VercelHistoryData /> : null;
+}
+
+function VercelHistoryData() {
+  const c = useFeature();
+  const query = useData<VercelHistoryResponse>(['vercel-history', c.siteId], signal =>
+    c.api.get(`/liekan/websites/${c.siteId}/vercel-history`, {}, signal));
+  return <VercelHistoryCard response={query.data} failed={!!query.error} />;
+}
+
+export function VercelHistoryCard({ response, failed = false }: {
+  response?: VercelHistoryResponse; failed?: boolean;
+}) {
+  const i18n = useLiekanI18n();
+  if (!failed && (!response || response.state === 'not_connected')) return null;
+  const snapshot = !failed && response?.state === 'available' ? response.snapshot : null;
+  return (
+    <section className="card p-5 space-y-3" aria-label={i18n.text('Vercel 历史访问')}>
+      <div className="flex flex-wrap justify-between items-start gap-3">
+        <div>
+          <h2 className="text-[14px] font-bold">{i18n.text('Vercel 历史访问')}</h2>
+          <p className="text-[12px] text-sub mt-1">{i18n.text('独立历史快照 · 非实时 · 不随上方日期筛选变化')}</p>
+        </div>
+        <strong className="text-[24px] text-brand">{snapshot ? `${snapshot.pageviews} PV` : '—'}</strong>
+      </div>
+      {snapshot ? <>
+        <p className="text-[12px] text-sub">{snapshot.hostname} · {snapshot.startAt.slice(0, 10)} 00:00 ≤ UTC &lt; {snapshot.endAt.slice(0, 10)} 00:00</p>
+        <p className="text-[12px] text-sub">{i18n.text('快照读取时间')}：{snapshot.collectedAt.replace('T', ' ').replace('Z', ' UTC')}</p>
+        <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
+          <HistoryRows title={i18n.text('页面浏览')} rows={snapshot.paths} />
+          <HistoryRows title={i18n.text('来源域名')} rows={snapshot.referrers.map(row => ({ ...row, label: row.label || i18n.text('来源缺失 / 未知') }))} />
+        </div>
+        <p className="text-[12px] text-sub leading-relaxed">{i18n.text('PV 是采集到的页面浏览次数，不是人数或询盘；未独立排除员工与自动检查。空来源不能推断为直接访问或 AI 来源。此快照未并入 GEOInflow 的浏览、访客及转化统计，也不代表 GEO 效果提升。')}</p>
+      </> : <p className="text-[12px] text-sub">{i18n.text('历史快照暂不可用，未按 0 处理。')}</p>}
+    </section>
+  );
+}
+
+function HistoryRows({ title, rows }: { title: string; rows: { label: string; pageviews: number }[] }) {
+  return <details><summary className="text-[12px] cursor-pointer">{title}</summary>
+    <table className="w-full text-[12px] mt-2"><caption className="sr-only">{title}</caption><tbody>{rows.map(row =>
+      <tr key={row.label}><th className="text-left font-normal break-all py-1 pr-3" scope="row">{row.label}</th><td className="text-right whitespace-nowrap">{row.pageviews} PV</td></tr>
+    )}</tbody></table>
+  </details>;
+}
