+import { z } from 'zod';
+
+const count = z.number().int().nonnegative().safe();
+const utc = z.string().datetime({ offset: false });
+const group = z.object({ label: z.string().max(512), pageviews: count }).strict();
+
+// An independent aggregate snapshot, never a source of browser sessions/events.
+export const vercelHistorySchema = z.object({
+  version: z.literal(1),
+  websiteId: z.uuid(),
+  provider: z.literal('Vercel Web Analytics'),
+  projectId: z.string().regex(/^prj_[A-Za-z0-9]+$/),
+  hostname: z.enum(['himaxtec.com', 'www.himaxtec.com']),
+  environment: z.literal('production'),
+  timezone: z.literal('UTC'),
+  startAt: utc,
+  endAt: utc,
+  collectedAt: utc,
+  pageviews: count,
+  paths: z.array(group).max(100),
+  referrers: z.array(group).max(100),
+  evidenceSha256: z.string().regex(/^[a-f0-9]{64}$/),
+  refreshMode: z.literal('manual_snapshot'),
+}).strict().superRefine((value, ctx) => {
+  const start = Date.parse(value.startAt), end = Date.parse(value.endAt);
+  const collected = Date.parse(value.collectedAt), day = 86400000;
+  if (start % day || end % day || end <= start || end - start > 31 * day || collected < end)
+    ctx.addIssue({ code: 'custom', message: 'Complete UTC days and dated evidence required' });
+  for (const rows of [value.paths, value.referrers]) {
+    if (rows.reduce((sum, row) => sum + row.pageviews, 0) !== value.pageviews ||
+        new Set(rows.map(row => row.label)).size !== rows.length)
+      ctx.addIssue({ code: 'custom', message: 'Complete, unique groups must reconcile to the total' });
+  }
+});
+
+export type VercelHistory = z.infer<typeof vercelHistorySchema>;
+export type VercelHistoryResponse =
+  | { state: 'available'; snapshot: VercelHistory }
+  | { state: 'not_connected' | 'unavailable'; snapshot: null };
