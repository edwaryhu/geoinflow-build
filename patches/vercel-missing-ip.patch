+  'Himax-GEO-Release-Verification/1.0 (site-owner technical audit)',
+  'Himax-Official-Catalog-Audit/1.0',
+]);
+const auditStart = Date.parse('2026-11-03T16:00:00Z');
+const auditEnd = Date.parse('2026-11-04T16:00:00Z');
+export function vercelRequestPurpose(agent: string, time: number): RequestPurpose {
+  // Exact dedicated UAs corroborated by the owner's scripts and this dated batch.
+  if (time >= auditStart && time < auditEnd && confirmedAuditAgents.has(agent)) return 'internal_check';
