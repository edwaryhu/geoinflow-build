+afterAll(async()=>{if(db)await db.end();});
+it('preserves legacy rows while permitting explicitly marked true missing fields',async()=>{
+ await db.query(insert('valid'));
+ expect((await db.query("SELECT ip_hash,ip_masked,bytes,verification FROM liekan_log WHERE id='valid'")).rows[0]).toEqual({ip_hash:null,ip_masked:null,bytes:null,verification:'unverified'});
+ expect((await db.query("SELECT count(*)::int AS n FROM liekan_log WHERE id='legacy'")).rows[0].n).toBe(1);
