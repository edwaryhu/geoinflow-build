+const quote=(value:unknown)=>value==null?'NULL':typeof value==='number'?String(value):`'${String(value).replaceAll("'","''")}'`;
+function insert(id:string,changes:Record<string,unknown>={}) {
+ const fields={id,ip_hash:null,ip_masked:null,bytes:null,verification:'unverified',verification_version:null,
+  verification_observed_at:null,verification_reason:'missing_client_ip',event_digest:'a'.repeat(64),status:404,
+  ip_availability:'provider_unavailable',request_provenance:JSON.stringify(provenance),...changes};
+ return `INSERT INTO liekan_log(${Object.keys(fields).join(',')}) VALUES(${Object.values(fields).map(quote).join(',')});`;
+}
+beforeAll(async()=>{
+ const value=process.env.HIMAX_GEO_PATCH_TEST_PG;
