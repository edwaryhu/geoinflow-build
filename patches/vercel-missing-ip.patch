+        identityAvailability: 'missing', reason: 'missing_client_ip', purpose,
+        purposeEvidence: purpose === 'internal_check' ? 'exact_audit_ua_20261104' : null,
+        country: row.clientIpCountry || null, countryBasis: 'provider_declared',
+        timeRange: input.timeRange, hasMore: input.hasMore, excludedIntervals: input.excludedIntervals,
+      };
