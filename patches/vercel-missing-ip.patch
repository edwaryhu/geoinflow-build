+        measurement: { version: 'log-measurement-v1', host: host(domain), hostBasis: 'request_host',
+          sourceConfigVersion: VERSION, samplingRate: null, samplingBasis: 'unknown',
+          bytesAvailability: 'missing', bytesUnit: 'unknown', requestEvidence: requestProvenance },
+      });
