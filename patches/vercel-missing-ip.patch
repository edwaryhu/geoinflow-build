+const utc = z.string().regex(/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,9})?Z$/).refine(value => {
+  try { parseStrictDate(value); return true; } catch { return false; }
+});
+export const vercelRequestImportSchema = z.object({
+  format: z.literal('vercel_requests'),
+  projectId: z.string().regex(/^prj_[A-Za-z0-9]+$/),
+  environment: z.literal('production'),
+  hostname: z.string().min(1).max(253),
+  timeRange: z.object({ start: utc, end: utc }),
+  hasMore: z.boolean(),
+  excludedIntervals: z.array(z.object({ start: utc, end: utc })).max(100),
+  records: z.array(z.record(z.string(), z.unknown())).min(1).max(1000),
+});
+const recordSchema = z.object({
+  timestamp: utc,
+  projectId: z.string(),
+  requestId: z.string().min(1).max(250).refine(s => !/[\x00-\x1f]/.test(s)),
+  requestHostname: z.string().min(1).max(253),
+  requestPath: z.string().min(1).max(4096).refine(s => !/[\x00-\x1f]|%00/i.test(s)),
+  requestMethod: z.enum(['GET', 'HEAD', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS']),
+  httpStatus: z.number().int().min(100).max(599),
+  environment: z.literal('production'),
+  clientUserAgent: z.string().max(500).refine(s => !/[\x00-\x1f]/.test(s)),
