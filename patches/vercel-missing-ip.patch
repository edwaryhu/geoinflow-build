+        time: time.toISOString(), path, method: row.requestMethod, status: row.httpStatus,
+        bytes: null, ipMasked: null, ipHash: null, userAgent,
+        location: row.clientIpCountry ? `${row.clientIpCountry} (Vercel 声明，未核验 IP)` : '未知',
+        declaredLocation: row.clientIpCountry || null,
+        bot: bot.name, vendor: bot.vendor, type: bot.type,
+        verification: 'unverified', verificationVersion: null, verificationObservedAt: null,
+        verificationReason: 'missing_client_ip',
+        aiEligible: bot.aiEligible ?? ['训练', '搜索', '用户触发'].includes(bot.type),
+        recognitionState: bot.recognition ?? (crawlerIdForRule(bot) ? 'recognized' : bot.pattern ? 'custom' : 'unknown'),
+        recognitionCandidates: bot.candidateIds ?? [],
